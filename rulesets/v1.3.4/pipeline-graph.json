{
  "rulesetVersion": "1.3.4",
  "roots": ["gameLoop", "serverBoundary"],
  "pipelines": [
    "gameLoop", "serverBoundary", "turn", "phase", "action", "cardUse",
    "abilityActivation", "effectExecution", "attack", "response", "judgment",
    "damage", "dying", "elimination", "duration"
  ],
  "edges": [
    { "from": "gameLoop", "to": "turn", "cause": "next eligible turn" },
    { "from": "turn", "to": "phase", "cause": "ordered phase loop" },
    { "from": "phase", "to": "action", "cause": "legal active action" },
    { "from": "serverBoundary", "to": "action", "cause": "validated player command" },
    { "from": "action", "to": "cardUse", "cause": "card action committed" },
    { "from": "action", "to": "attack", "cause": "attack action committed" },
    { "from": "action", "to": "abilityActivation", "cause": "ability action committed" },
    { "from": "cardUse", "to": "response", "cause": "card response window" },
    { "from": "cardUse", "to": "effectExecution", "cause": "card effect resolution" },
    { "from": "abilityActivation", "to": "effectExecution", "cause": "ability resolution" },
    { "from": "effectExecution", "to": "cardUse", "cause": "use/play/respond card operation" },
    { "from": "effectExecution", "to": "attack", "cause": "createAttack" },
    { "from": "effectExecution", "to": "response", "cause": "response operation" },
    { "from": "effectExecution", "to": "judgment", "cause": "judgeColor" },
    { "from": "effectExecution", "to": "damage", "cause": "createDamage" },
    { "from": "effectExecution", "to": "dying", "cause": "checkDying" },
    { "from": "effectExecution", "to": "duration", "cause": "createDuration or scheduleEffect" },
    { "from": "attack", "to": "response", "cause": "attack response window" },
    { "from": "attack", "to": "judgment", "cause": "critical or weapon judgment" },
    { "from": "attack", "to": "damage", "cause": "hit damage segments" },
    { "from": "attack", "to": "dying", "cause": "complete target dying before next target" },
    { "from": "judgment", "to": "response", "cause": "judgment intervention window" },
    { "from": "damage", "to": "dying", "cause": "hp at or below zero after segment" },
    { "from": "dying", "to": "response", "cause": "rescue window" },
    { "from": "dying", "to": "elimination", "cause": "unresolved dying and no death replacement" },
    { "from": "elimination", "to": "gameLoop", "cause": "victory check" },
    { "from": "duration", "to": "effectExecution", "cause": "activation, expiry or cleanup" }
  ],
  "operationEntrypoints": {
    "useCard": "cardUse",
    "playCard": "cardUse",
    "respondCard": "cardUse",
    "createAttack": "attack",
    "openResponseWindow": "response",
    "requestSpecialPlay": "response",
    "judgeColor": "judgment",
    "replaceJudgment": "judgment",
    "createDamage": "damage",
    "checkDying": "dying",
    "createDuration": "duration",
    "expireDuration": "duration",
    "scheduleEffect": "duration",
    "cancelScheduledEffect": "duration"
  }
}
