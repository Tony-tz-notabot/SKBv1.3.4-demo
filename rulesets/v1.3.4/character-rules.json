 "rules": [
  {
   "ruleId": "character.cardChoice.hiddenHand",
   "testIds": [
    "R001"
   ],
   "characterId": "*",
   "abilityIds": [],
   "listen": "choice.requested",
   "effects": [
    {
     "op": "filterView",
     "params": {
      "when": "$choice.targetCard",
      "public": "faceUpNamed",
      "hand": "shuffledCardBackOnly"
     }
    }
   ],
   "assertions": [
    "hidden identities never sent"
   ]
  },
  {
   "ruleId": "character.defaultRange",
   "testIds": [
    "R002"
   ],
   "characterId": "*",
   "abilityIds": [],
   "listen": "action.legality.check",
   "effects": [
    {
     "op": "modifyEvent",
     "params": {
      "abilityRangeDefault": "unlimited",
      "weaponOrUnarmedUsesAttackRange": true
     }
    }
   ],
   "assertions": [
    "missing range is not zero"
   ]
  },
  {
   "ruleId": "character.drawModifier.clampLate",
   "testIds": [
    "R003"
   ],
   "characterId": "*",
   "abilityIds": [],
   "listen": "phase.body",
   "effects": [
    {
     "op": "clampValue",
     "params": {
      "when": "$phase=draw",
      "path": "actualDraw",
      "min": 0,
      "afterAllModifiers": true
     }
    }
   ],
   "assertions": [
    "intermediate draw may be negative"
   ]
  },
  {
   "ruleId": "character.cost.zoneStrict",
   "testIds": [
    "R004"
   ],
   "characterId": "*",
   "abilityIds": [],
   "listen": "cost.calculate",
   "effects": [
    {
     "op": "assert",
     "params": {
      "cardMeansAllLegalZones": true,
      "handCardMeansHandOnly": true
     }
    }
   ],
   "assertions": [
    "cost selectors preserve wording"
   ]
  },
  {
   "ruleId": "character.knight.instinct",
   "testIds": [
    "R005"
   ],
   "characterId": "character.knight",
   "abilityIds": [
    "skill.knight.instinct"
   ],
   "listen": "card.used",
   "effects": [
    {
     "op": "transformCard",
     "target": "$card",
     "params": {
      "temporaryTemplate": "statue.knight.$printedColor",
      "retainPrintedColor": true,
      "restoreBeforeExit": true,
      "public": true
     }
    }
   ],
   "assertions": [
    "paladin statue may respond"
   ]
  },
  {
   "ruleId": "character.alchemist.toxicBottle",
   "testIds": [
    "R006"
   ],
   "characterId": "character.alchemist",
   "abilityIds": [
    "skill.alchemist.toxic_reagent"
   ],
   "listen": "ability.activation.committed",
   "effects": [
    {
     "op": "createAttack",
     "params": {
      "range": 2,
      "types": [
       "field"
      ],
      "targetCount": 1,
      "damage": [
       {
        "type": "poison",
        "amount": 1,
        "repeat": 2
       }
      ],
      "ignoreTalentModifiers": true
     }
    }
   ],
   "assertions": [
    "field response tags apply"
   ]
  },
  {
   "ruleId": "character.headtaker.owl",
   "testIds": [
    "R007"
   ],
   "characterId": "character.headtaker",
   "abilityIds": [
    "talent.owl"
   ],
   "listen": "attack.target.after",
   "effects": [
    {
     "op": "createAttack",
     "params": {
      "when": "$actualDamageFromSource>0",
      "optional": true,
      "limit": {
       "scope": "perRoundOwner",
       "count": 1
      },
      "range": "unlimited",
      "type": "ranged",
      "damage": 2
     }
    }
   ],
   "assertions": [
    "waits until all source segments end"
   ]
  },
  {
   "ruleId": "character.headtaker.kick",
   "testIds": [
    "R008"
   ],
   "characterId": "character.headtaker",
   "abilityIds": [
    "skill.headtaker.spartan_kick"
   ],
   "listen": "ability.activation.committed",
   "effects": [
    {
     "op": "createDamage",
     "params": {
      "type": "shield",
      "amount": "$discardedHandCount",
      "direct": true
     }
    },
    {
     "op": "applyRestriction",
     "params": {
      "branch": "shieldBroken?selfDrawMinus1:targetDrawMinus1",
      "stackPolicy": "stackInstances",
      "expiry": "affected.nextDraw.after"
     }
    }
   ],
   "assertions": [
    "at least one hand card discarded"
   ]
  },
  {
   "ruleId": "character.werewolf.notebook",
   "testIds": [
    "R009"
   ],
   "characterId": "character.werewolf",
   "abilityIds": [
    "skill.werewolf.notebook"
   ],
   "listen": "ability.activation.committed",
   "effects": [
    {
     "op": "changeMaxHp",
     "target": "$source",
     "value": 1
    },
    {
     "op": "switch",
     "params": {
      "on": "$target.shield>0",
      "cases": {
       "true": "setShield0",
       "false": "setHp1"
      }
     }
    }
   ],
   "assertions": [
    "five different-color hand cards paid first"
   ]
  },
  {
   "ruleId": "character.paladin.barrierModes",
   "testIds": [
    "R010"
   ],
   "characterId": "character.paladin",
   "abilityIds": [
    "skill.paladin.divine_barrier"
   ],
   "listen": "ability.activation.committed",
   "effects": [
    {
     "op": "if",
     "params": {
      "condition": "$window=damage.proposed"
     },
     "then": [
      {
       "op": "preventDamage",
       "target": "$damage"
      }
     ]
    },
    {
     "op": "applyStatus",
     "target": "$source",
     "params": {
      "statusId": "status.invincible"
     },
     "expiry": {
      "point": "owner.nextPhase.prepare.before",
      "skipPolicy": "expireOnSkippedBoundary"
     }
    }
   ],
   "assertions": [
    "active mode only grants invincible"
   ]
  },
  {
   "ruleId": "character.paladin.barrierCost",
   "testIds": [
    "R011"
   ],
   "characterId": "character.paladin",
   "abilityIds": [
    "skill.paladin.divine_barrier"
   ],
   "listen": "card.lost",
   "effects": [
    {
     "op": "emitEvent",
     "params": {
      "when": "$card.wasEquipped && $move.costOf=skill.paladin.divine_barrier",
      "event": "card.unequipped"
     }
    }
   ],
   "assertions": [
    "two blue cards may come from legal non-hand zones"
   ]
  },
  {
   "ruleId": "character.elf.focusSource",
   "testIds": [
    "R012"
   ],
   "characterId": "character.elf",
   "abilityIds": [
    "skill.elf.focused_shot"
   ],
   "listen": "attack.target.after",
   "effects": [
    {
     "op": "addMarker",
     "target": "$owner",
     "params": {
      "markerId": "elf.aim",
      "value": "$damageSource",
      "replaceExisting": true,
      "when": "$actualHpLoss>0"
     }
    }
   ],
   "assertions": [
    "latest qualifying source overwrites"
   ]
  },
  {
   "ruleId": "character.elf.aimAttack",
   "testIds": [
    "R013"
   ],
   "characterId": "character.elf",
   "abilityIds": [
    "skill.elf.focused_shot"
   ],
   "listen": "attack.costs.paid",
   "effects": [
    {
     "op": "modifyEvent",
     "params": {
      "when": "$target=$owner.marker(elf.aim)",
      "killStillRequired": true,
      "preselectedWeaponStillRequired": true,
      "attackCountCost": 0
     }
    },
    {
     "op": "resetMarker",
     "params": {
      "when": "$attack.actualHpLossToAimTarget>0",
      "markerId": "elf.aim"
     }
    }
   ],
   "assertions": [
    "only attack count is waived"
   ]
  },
  {
   "ruleId": "character.ranger.rollDuration",
   "testIds": [
    "R014"
   ],
   "characterId": "character.ranger",
   "abilityIds": [
    "skill.ranger.roll"
   ],
   "listen": "response.committed",
   "effects": [
    {
     "op": "createDuration",
     "params": {
      "activationPoint": "owner.nextTurn.start",
      "effect": "killAttacksGuaranteedCritical"
     },
     "expiry": {
      "point": "owner.nextTurn.end",
      "skipPolicy": "expireOnSkippedBoundary"
     }
    }
   ],
   "assertions": [
    "not active during current turn"
   ]
  },
  {
   "ruleId": "character.taoist.reflection",
   "testIds": [
    "R015"
   ],
   "characterId": "character.taoist",
   "abilityIds": [
    "skill.taoist.attack_reflection"
   ],
   "listen": "attack.miss",
   "effects": [
    {
     "op": "createAttack",
     "params": {
      "when": "$miss.causedByAvoidance && $attack.ranged",
      "copyUnresolvedParameters": true,
      "source": "$original.source",
      "target": "$original.source",
      "cost": "none"
     }
    }
   ],
   "assertions": [
    "reflector is not damage source"
   ]
  },
  {
   "ruleId": "character.reflection.chainLimit",
   "testIds": [
    "R016"
   ],
   "characterId": "*",
   "abilityIds": [
    "skill.taoist.attack_reflection",
    "talent.melee_counter"
   ],
   "listen": "attack.miss",
   "effects": [
    {
     "op": "assert",
     "params": {
      "maxChainDepth": 10
     }
    },
    {
     "op": "return",
     "params": {
      "when": "$attack.chainDepth>=10",
      "result": "doNotCreateNext"
     }
    }
   ],
   "assertions": [
    "no eleventh attack"
   ]
  },
  {
   "ruleId": "character.priest.prayLimit",
   "testIds": [
    "R017"
   ],
   "characterId": "character.priest",
   "abilityIds": [
    "skill.priest.pray"
   ],
   "listen": "ability.activation.committed",
   "effects": [
    {
     "op": "consumeLimit",
     "params": {
      "limitId": "priest.pray",
      "scope": "perRoundOwner",
      "sharedAcrossTurnWindows": true,
      "reset": "owner.prepare"
     }
    }
   ],
   "assertions": [
    "inside/outside turn share limit"
   ]
  },
  {
   "ruleId": "character.priest.hopeCost",
   "testIds": [
    "R018"
   ],
   "characterId": "character.priest",
   "abilityIds": [
    "skill.priest.hope"
   ],
   "listen": "cost.calculate",
   "effects": [
    {
     "op": "assert",
     "params": {
      "selector": {
       "zone": "hand",
       "color": "white"
      },
      "count": 1
     }
    }
   ],
   "assertions": [
    "equipment and judgment cards excluded"
   ]
  },
  {
   "ruleId": "character.punchingBag.inertiaAccounting",
   "testIds": [
    "R019"
   ],
   "characterId": "character.punching_bag",
   "abilityIds": [
    "skill.punching_bag.inertial_counter"
   ],
   "listen": "damage.applied",
   "effects": [
    {
     "op": "modifyMarker",
     "params": {
      "markerId": "punchingBag.inertia.bySource",
      "add": "$specialLayerLost+$shieldLost+$hpLost",
      "exclude": [
       "zeroDamage",
       "modify"
      ]
     }
    }
   ],
   "assertions": [
    "all actual damage layers count"
   ]
  },
  {
   "ruleId": "character.punchingBag.inertiaSource",
   "testIds": [
    "R020"
   ],
   "characterId": "character.punching_bag",
   "abilityIds": [
    "skill.punching_bag.inertial_counter"
   ],
   "listen": "phase.start",
   "effects": [
    {
     "op": "repeat",
     "params": {
      "when": "$phase=end && $activeCharacter=$source",
      "count": "floor($inertia/3)"
     },
     "effects": [
      {
       "op": "createDamage",
       "params": {
        "target": "$source",
        "amount": 1,
        "type": "true",
        "direct": true
       }
      }
     ],
     "maxIterations": 100
    },
    {
     "op": "setValue",
     "params": {
      "path": "$inertia",
      "value": "$inertia mod 3",
      "clearIf": "$source.eliminated"
     }
    }
   ],
   "assertions": [
    "dead non-eliminated remains valid"
   ]
  },
  {
   "ruleId": "character.traveler.healthFloor",
   "testIds": [
    "R021"
   ],
   "characterId": "character.interdimensional_traveler",
   "abilityIds": [
    "talent.parallel_traversal"
   ],
   "listen": "phase.start",
   "effects": [
    {
