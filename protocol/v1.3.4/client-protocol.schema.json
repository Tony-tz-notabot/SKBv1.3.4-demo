{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skb://protocol/v1.3.4/client-protocol.schema.json",
  "title": "SKB v1.3.4 Client Protocol",
  "oneOf": [
    {
      "$ref": "#/$defs/SetupSnapshot"
    },
    {
      "$ref": "#/$defs/GameSnapshot"
    },
    {
      "$ref": "#/$defs/GameCommand"
    },
    {
      "$ref": "#/$defs/CommandAccepted"
    },
    {
      "$ref": "#/$defs/CommandRejected"
    },
    {
      "$ref": "#/$defs/PresentationEvent"
    }
  ],
  "$defs": {
    "Seat": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "Team": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "Phase": {
      "type": "string",
      "enum": [
        "prepare",
        "judgment",
        "draw",
        "play",
        "discard",
        "end"
      ]
    },
    "ObjectRef": {
      "type": "string",
      "pattern": "^(public|private|concealed):"
    },
    "CardCategory": {
      "type": "string",
      "enum": [
        "basic",
        "weapon",
        "armor",
        "talent",
        "mount",
        "statue",
        "special",
        "boss"
      ]
    },
    "CardColor": {
      "type": "string",
      "enum": [
        "white",
        "red",
        "orange",
        "blue",
        "green",
        "none"
      ]
    },
    "LifeState": {
      "type": "string",
      "enum": [
        "inPlay",
        "leftPlay",
        "deadNotEliminated",
        "dead",
        "eliminated"
      ]
    },
    "CoreStat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "CardStateView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective",
        "selected"
      ],
      "properties": {
        "effective": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "modeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "modeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "charge": {
          "type": [
            "integer",
            "null"
          ]
        },
        "durability": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cooldown": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "CardView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "displayName",
        "category",
        "printedColor",
        "resourceKey",
        "summary",
        "coreStats",
        "badges",
        "state",
        "detailAvailable"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "templateId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/CardCategory"
        },
        "printedColor": {
          "$ref": "#/$defs/CardColor"
        },
        "resourceKey": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "coreStats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoreStat"
          }
        },
        "badges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "$ref": "#/$defs/CardStateView"
        },
        "detailAvailable": {
          "type": "boolean"
        }
      }
    },
    "EquipmentSlotsView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weapon1",
        "weapon2",
        "weapon3",
        "thirdWeapon",
        "armor",
        "mountOffense",
        "mountDefense",
        "talents",
        "boss",
        "tripleWield",
        "mountOccupied",
        "mountDual"
      ],
      "properties": {
        "weapon1": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardView"
            },
            {
              "type": "null"
            }
          ]
        },
        "weapon2": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardView"
            },
            {
              "type": "null"
            }
          ]
        },
        "weapon3": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardView"
            },
            {
              "type": "null"
            }
          ]
        },
        "thirdWeapon": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardView"
            },
            {
              "type": "null"
            }
          ]
        },
        "armor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardView"
            },
            {
              "type": "null"
            }
          ]
        },
        "mountOffense": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardView"
            },
            {
              "type": "null"
            }
          ]
        },
        "mountDefense": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardView"
            },
            {
              "type": "null"
            }
          ]
        },
        "talents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardView"
          }
        },
        "boss": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardView"
            },
            {
              "type": "null"
            }
          ]
        },
        "tripleWield": {
          "type": "boolean"
        },
        "mountOccupied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mountDual": {
          "type": "boolean"
        }
      }
    },
    "PlayerView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seat",
        "team",
        "nickname",
        "connected",
        "lifeState",
        "handCount",
        "handLimit",
        "equipment",
        "equipmentSlots",
        "judgmentZone",
        "statuses"
      ],
      "properties": {
        "seat": {
          "$ref": "#/$defs/Seat"
        },
        "team": {
          "$ref": "#/$defs/Team"
        },
        "nickname": {
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "characterId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifeState": {
          "$ref": "#/$defs/LifeState"
        },
        "hp": {
          "type": [
            "integer",
            "null"
          ]
        },
        "maxHp": {
          "type": [
            "integer",
            "null"
          ]
        },
        "shield": {
          "type": [
            "integer",
            "null"
          ]
        },
        "maxShield": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ironShield": {
          "type": "integer"
        },
        "handCount": {
          "type": "integer",
          "minimum": 0
        },
        "handLimit": {
          "type": "integer",
          "minimum": 0
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardView"
          }
        },
        "equipmentSlots": {
          "$ref": "#/$defs/EquipmentSlotsView"
        },
        "judgmentZone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardView"
          }
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PublicView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "activeSeat",
        "phase",
        "players",
        "drawPileCount",
        "discardTop",
        "centralCards"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "activeSeat": {
          "$ref": "#/$defs/Seat"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "players": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/PlayerView"
          }
        },
        "drawPileCount": {
          "type": "integer",
          "minimum": 0
        },
        "discardTop": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardView"
          }
        },
        "centralCards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardView"
          }
        },
        "headline": {
          "type": "string"
        },
        "winnerTeam": {
          "anyOf": [
            {
              "$ref": "#/$defs/Team"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PrivateView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hand",
        "preselectedWeaponSlot",
        "preselectedModeId",
        "preselectableWeaponSlots",
        "concealedChoices"
      ],
      "properties": {
        "hand": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardView"
          }
        },
        "characterCandidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preselectedWeaponSlot": {
          "type": [
            "string",
            "null"
          ]
        },
        "preselectedModeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "preselectableWeaponSlots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "concealedChoices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        }
      }
    },
    "PromptView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptId",
        "kind",
        "mandatory",
        "deadlineAt",
        "prioritySeat",
        "timeoutPolicy"
      ],
      "properties": {
        "promptId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "mandatory": {
          "type": "boolean"
        },
        "deadlineAt": {
          "type": "integer"
        },
        "prioritySeat": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeoutPolicy": {
          "type": "string",
          "enum": [
            "pass",
            "randomLegal",
            "useDefault",
            "abortRemaining"
          ]
        }
      }
    },
    "ActiveWindowView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prioritySeat",
        "deadlineAt"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "prioritySeat": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadlineAt": {
          "type": "integer"
        },
        "attackerSeat": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "abilityId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TargetRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "distinct"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "distinct": {
          "type": "boolean"
        }
      }
    },
    "SelectionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "min",
        "max"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "cards",
            "targets",
            "option",
            "number",
            "color",
            "mode",
            "confirm"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "distinct": {
          "type": "boolean"
        },
        "legalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "OfferPreview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weaponRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "modeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "type": [
            "integer",
            "null"
          ]
        },
        "distanceByTarget": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "damageStructure": {
          "type": [
            "string",
            "null"
          ]
        },
        "costSummary": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "InteractionOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offerId",
        "kind",
        "sourceRefs",
        "legalTargetRefs",
        "selectionSpecs",
        "preview"
      ],
      "properties": {
        "offerId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "declareAttack",
            "useCard",
            "activateAbility",
            "respond",
            "equip",
            "discardEquipment",
            "dismantle",
            "synthesize",
            "interveneJudgment",
            "rescueDying",
            "resolveChoice",
            "pass",
            "endPhase",
            "chargeWeapon",
            "activateWeapon"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "legalTargetRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "selectionSpecs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectionSpec"
          }
        },
        "targetRule": {
          "$ref": "#/$defs/TargetRule"
        },
        "preview": {
          "$ref": "#/$defs/OfferPreview"
        }
      }
    },
    "DisabledHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectRef",
        "reasonCode",
        "messageKey"
      ],
      "properties": {
        "subjectRef": {
          "$ref": "#/$defs/ObjectRef"
        },
        "reasonCode": {
          "type": "string"
        },
        "messageKey": {
          "type": "string"
        }
      }
    },
    "InteractionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offers",
        "disabledHints"
      ],
      "properties": {
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptView"
            },
            {
              "type": "null"
            }
          ]
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionOffer"
          }
        },
        "disabledHints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DisabledHint"
          }
        }
      }
    },
    "ChatMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "channel",
        "senderSeat",
        "sentAt",
        "text"
      ],
      "properties": {
        "messageId": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "enum": [
            "all",
            "team"
          ]
        },
        "senderSeat": {
          "$ref": "#/$defs/Seat"
        },
        "sentAt": {
          "type": "integer"
        },
        "text": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "SetupCardView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "templateId",
        "displayName",
        "category",
        "printedColor",
        "resourceKey"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "templateId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/CardCategory"
        },
        "printedColor": {
          "$ref": "#/$defs/CardColor"
        },
        "resourceKey": {
          "type": "string"
        }
      }
    },
    "SetupSeatState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seat",
        "handCount",
        "redrawDecided"
      ],
      "properties": {
        "seat": {
          "$ref": "#/$defs/Seat"
        },
        "handCount": {
          "type": "integer",
          "minimum": 0
        },
        "redrawDecided": {
          "type": "boolean"
        }
      }
    },
    "SetupSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "gameId",
        "rulesetVersion",
        "stateRevision",
        "lastEventSeq",
        "serverTime",
        "lifecycle",
        "viewer",
        "firstSeat",
        "drawPileCount",
        "discardPile",
        "seats",
        "hand",
        "redrawUsed",
        "interaction"
      ],
      "properties": {
        "type": {
          "const": "SETUP_SNAPSHOT"
        },
        "gameId": {
          "type": "string"
        },
        "rulesetVersion": {
          "const": "1.3.4"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "lastEventSeq": {
          "type": "integer",
          "minimum": 0
        },
        "serverTime": {
          "type": "integer"
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "setupRedraw",
            "inProgress"
          ]
        },
        "viewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "userId",
            "seat",
            "team"
          ],
          "properties": {
            "userId": {
              "type": [
                "string",
                "null"
              ]
            },
            "seat": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Seat"
                },
                {
                  "type": "null"
                }
              ]
            },
            "team": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Team"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "firstSeat": {
          "$ref": "#/$defs/Seat"
        },
        "drawPileCount": {
          "type": "integer",
          "minimum": 0
        },
        "discardPile": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SetupCardView"
          }
        },
        "seats": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/SetupSeatState"
          }
        },
        "hand": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SetupCardView"
          }
        },
        "redrawUsed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "interaction": {
          "$ref": "#/$defs/InteractionView"
        }
      }
    },
    "GameSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "gameId",
        "rulesetVersion",
        "stateRevision",
        "lastEventSeq",
        "serverTime",
        "viewer",
        "publicView",
        "privateView",
        "interaction",
        "activeWindow",
        "chat"
      ],
      "properties": {
        "type": {
          "const": "GAME_SNAPSHOT"
        },
        "gameId": {
          "type": "string"
        },
        "rulesetVersion": {
          "const": "1.3.4"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "lastEventSeq": {
          "type": "integer",
          "minimum": 0
        },
        "serverTime": {
          "type": "integer"
        },
        "viewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "userId",
            "seat",
            "team"
          ],
          "properties": {
            "userId": {
              "type": "string"
            },
            "seat": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Seat"
                },
                {
                  "type": "null"
                }
              ]
            },
            "team": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Team"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "publicView": {
          "$ref": "#/$defs/PublicView"
        },
        "privateView": {
          "$ref": "#/$defs/PrivateView"
        },
        "interaction": {
          "$ref": "#/$defs/InteractionView"
        },
        "activeWindow": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActiveWindowView"
